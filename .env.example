# Copy to .env.local. Never commit real credentials.
# All external integrations are optional; the app labels local/replay mode.
TRAVEL_PORT=8765
# Managed Cortex Agent. The ignored runtime/connections.toml uses Snowflake CLI format.
SNOWFLAKE_CONNECTIONS_FILE=runtime/connections.toml
SNOWFLAKE_CONNECTION_NAME=hackathon
# Aviationstack flight-status adapter; requires a plan permitting HTTPS.
AVIATIONSTACK_API_KEY=
# Google Maps Platform server key with Routes API enabled. Keep backend-only.
GOOGLE_ROUTES_API_KEY=
# Browser key for the interactive map. Restrict it to Maps JavaScript API and
# http://127.0.0.1:8765/* plus http://localhost:8765/* in Google Cloud.
GOOGLE_MAPS_BROWSER_KEY=
